// Implement the device protocol here; never claim a write succeeded without
// its documented confirmation. This starter does not access hardware.
pub fn request(device_key: &str, input: &str) -> String {
    let request: serde_json::Value = match serde_json::from_str(input) {
        Ok(request) => request,
        Err(error) => return serde_json::json!({"ok":false,"value":null,"error":error.to_string()}).to_string(),
    };
    let operation = request.get("op").and_then(serde_json::Value::as_str).unwrap_or("");
    serde_json::json!({"ok":false,"value":null,"error":format!("{device_key}: operation {operation} is not implemented")}).to_string()
}
