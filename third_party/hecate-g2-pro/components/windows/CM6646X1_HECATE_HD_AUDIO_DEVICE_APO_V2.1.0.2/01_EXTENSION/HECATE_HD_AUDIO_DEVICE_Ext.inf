[CMExt_Install]
; Nothing to do with

[CMExt_CAPX_Install]
; Nothing to do with

[CMExt_Install.Components]
AddComponent = CMAPO,,CMAPO_AddComponent

[CMExt_CAPX_Install.Components]
AddComponent = CMAPO,,CMAPO_AddComponent

[CMAPO_AddComponent]
ComponentIDs = VID_35BB&PID_A100&CMAPO_ICE
Description = "C-Media Audio Effects Component"
DisplayName = "C-Media Audio Effects Component"

[CMExt_Install.Interfaces]
AddInterface = %KSCATEGORY_AUDIO%,"globaltopo",CMExt.Interface
AddInterface = %KSCATEGORY_TOPOLOGY%,"globaltopo",CMExt.Interface

[CMExt_CAPX_Install.Interfaces]
AddInterface = %KSCATEGORY_AUDIO%,"globaltopo",CMExt_CAPX.Interface
AddInterface = %KSCATEGORY_TOPOLOGY%,"globaltopo",CMExt_CAPX.Interface

[CMExt.Interface]
AddReg = CMExt.AddReg, CMExt.Setting.AddReg

[CMExt_CAPX.Interface]
AddReg = CMExt.AddReg, CMExt_CAPX.Setting.AddReg

[CMExt.AddReg]
; Speaker
; SFX: C-Media Playback Audio Effect (SFX)
; MFX: C-Media Playback Audio Effect (MFX)
; EFX: C-Media Playback Audio Effect (EFX)
HKR,FX\0,%PKEY_ItemNameDisplay%,,%FriendlyName_Playback%
HKR,FX\0,%PKEY_FX_Association%,,%KSNODETYPE_SPEAKER%
HKR,FX\0,%PKEY_CompositeFX_EndpointEffectClsid%,%REG_MULTI_SZ%,%CMFX_PLAYBACK_EFX_CLSID%
HKR,FX\0,%PKEY_CompositeFX_ModeEffectClsid%,%REG_MULTI_SZ%,%CMFX_PLAYBACK_MFX_CLSID%
HKR,FX\0,%PKEY_CompositeFX_StreamEffectClsid%,%REG_MULTI_SZ%,%CMFX_PLAYBACK_SFX_CLSID%
HKR,FX\0,%PKEY_EFX_ProcessingModes_Supported_For_Streaming%,%REG_MULTI_SZ%,%AUDIO_SIGNALPROCESSINGMODE_DEFAULT%,%AUDIO_SIGNALPROCESSINGMODE_MEDIA%,%AUDIO_SIGNALPROCESSINGMODE_MOVIE%
HKR,FX\0,%PKEY_MFX_ProcessingModes_Supported_For_Streaming%,%REG_MULTI_SZ%,%AUDIO_SIGNALPROCESSINGMODE_DEFAULT%,%AUDIO_SIGNALPROCESSINGMODE_MEDIA%,%AUDIO_SIGNALPROCESSINGMODE_MOVIE%
HKR,FX\0,%PKEY_SFX_ProcessingModes_Supported_For_Streaming%,%REG_MULTI_SZ%,%AUDIO_SIGNALPROCESSINGMODE_DEFAULT%,%AUDIO_SIGNALPROCESSINGMODE_MEDIA%,%AUDIO_SIGNALPROCESSINGMODE_MOVIE%

; Headset Speaker
; SFX: -
; MFX: C-Media Playback Audio Effect (MFX)
; EFX: C-Media Playback Audio Effect (EFX)
HKR,FX\1,%PKEY_ItemNameDisplay%,,%FriendlyName_Playback%
HKR,FX\1,%PKEY_FX_Association%,,%KSNODETYPE_HEADSET_SPEAKERS%
HKR,FX\1,%PKEY_CompositeFX_EndpointEffectClsid%,%REG_MULTI_SZ%,%CMFX_PLAYBACK_EFX_CLSID%
HKR,FX\1,%PKEY_CompositeFX_ModeEffectClsid%,%REG_MULTI_SZ%,%CMFX_PLAYBACK_MFX_CLSID%
HKR,FX\1,%PKEY_EFX_ProcessingModes_Supported_For_Streaming%,%REG_MULTI_SZ%,%AUDIO_SIGNALPROCESSINGMODE_DEFAULT%,%AUDIO_SIGNALPROCESSINGMODE_MEDIA%,%AUDIO_SIGNALPROCESSINGMODE_MOVIE%,%AUDIO_SIGNALPROCESSINGMODE_RAW%,%AUDIO_SIGNALPROCESSINGMODE_COMMUNICATIONS%
HKR,FX\1,%PKEY_MFX_ProcessingModes_Supported_For_Streaming%,%REG_MULTI_SZ%,%AUDIO_SIGNALPROCESSINGMODE_DEFAULT%,%AUDIO_SIGNALPROCESSINGMODE_MEDIA%,%AUDIO_SIGNALPROCESSINGMODE_MOVIE%,%AUDIO_SIGNALPROCESSINGMODE_RAW%,%AUDIO_SIGNALPROCESSINGMODE_COMMUNICATIONS%

; Microphone
; SFX: -
; MFX: C-Media Recording Audio Effect (MFX)
; EFX: C-Media Recording Audio Effect (EFX)
HKR,FX\2,%PKEY_ItemNameDisplay%,,%FriendlyName_Recording%
HKR,FX\2,%PKEY_FX_Association%,,%KSNODETYPE_MICROPHONE%
HKR,FX\2,%PKEY_CompositeFX_EndpointEffectClsid%,%REG_MULTI_SZ%,%CMFX_RECORDING_EFX_CLSID%
HKR,FX\2,%PKEY_CompositeFX_ModeEffectClsid%,%REG_MULTI_SZ%,%CMFX_RECORDING_MFX_CLSID%
HKR,FX\2,%PKEY_EFX_ProcessingModes_Supported_For_Streaming%,%REG_MULTI_SZ%,%AUDIO_SIGNALPROCESSINGMODE_DEFAULT%,%AUDIO_SIGNALPROCESSINGMODE_MEDIA%,%AUDIO_SIGNALPROCESSINGMODE_MOVIE%,%AUDIO_SIGNALPROCESSINGMODE_RAW%,%AUDIO_SIGNALPROCESSINGMODE_COMMUNICATIONS%
HKR,FX\2,%PKEY_MFX_ProcessingModes_Supported_For_Streaming%,%REG_MULTI_SZ%,%AUDIO_SIGNALPROCESSINGMODE_DEFAULT%,%AUDIO_SIGNALPROCESSINGMODE_SPEECH%,%AUDIO_SIGNALPROCESSINGMODE_COMMUNICATIONS%

