HKR,FX\0\%CAPXSFX_PROPERTYSTORE_CONTEXT%,%PKEY_FX_Association%,,%KSNODETYPE_SPEAKER%
HKR,FX\0\%CAPXSFX_PROPERTYSTORE_CONTEXT%\User,%PKEY_Endpoint_Enable_AUDIOBRILLIANT_LFX%,%REG_DWORD%,0
HKR,FX\0\%CAPXSFX_PROPERTYSTORE_CONTEXT%\User,%PKEY_Endpoint_AUDIOBRILLIANT_LEVEL%,%REG_DWORD%,3
