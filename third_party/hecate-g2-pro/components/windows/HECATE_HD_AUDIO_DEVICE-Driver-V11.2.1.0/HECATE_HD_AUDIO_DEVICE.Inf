HKR,,FriendlyName,,%HECATE_HD_AUDIO_DEVICE.LINEIN.WAVE.szPname%

[HECATE_HD_AUDIO_DEVICE.I.SPDIFIN.WAVE.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%HECATE_HD_AUDIO_DEVICE.SPDIFIN.WAVE.szPname%

[HECATE_HD_AUDIO_DEVICE.I.HEADSETOUT.WAVE.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%HECATE_HD_AUDIO_DEVICE.HEADSETOUT.WAVE.szPname%

[HECATE_HD_AUDIO_DEVICE.I.GLOBAL.TOPO.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%HECATE_HD_AUDIO_DEVICE.GLOBAL.TOPO.szPname%

[HECATE_HD_AUDIO_DEVICE.EPProperties.AddReg]
HKR,"EP\\0",%PKEY_AudioEndpoint_Association%,,%KSNODETYPE_SPEAKER%
HKR,"EP\\0",%PKEY_AudioEndpoint_Supports_EventDriven_Mode%,0x00010001,0x1

HKR,"EP\\1",%PKEY_AudioEndpoint_Association%,,%KSNODETYPE_LINE_CONNECTOR%
HKR,"EP\\1",%PKEY_AudioEndpoint_Supports_EventDriven_Mode%,0x00010001,0x1

HKR,"EP\\2",%PKEY_AudioEndpoint_Association%,,%KSNODETYPE_HEADSET_SPEAKERS%
HKR,"EP\\2",%PKEY_AudioEndpoint_Supports_EventDriven_Mode%,0x00010001,0x1

HKR,"EP\\3",%PKEY_AudioEndpoint_Association%,,%KSNODETYPE_HEADPHONES%
HKR,"EP\\3",%PKEY_AudioEndpoint_Supports_EventDriven_Mode%,0x00010001,0x1

HKR,"EP\\4",%PKEY_AudioEndpoint_Association%,,%KSNODETYPE_DESKTOP_SPEAKER%
HKR,"EP\\4",%PKEY_AudioEndpoint_Supports_EventDriven_Mode%,0x00010001,0x1

HKR,"EP\\5",%PKEY_AudioEndpoint_Association%,,%KSNODETYPE_SPDIF_INTERFACE%
HKR,"EP\\5",%PKEY_AudioEndpoint_Supports_EventDriven_Mode%,0x00010001,0x1

HKR,"EP\\6",%PKEY_AudioEndpoint_Association%,,%KSNODETYPE_MICROPHONE%
HKR,"EP\\6",%PKEY_AudioEndpoint_Supports_EventDriven_Mode%,0x00010001,0x1

HKR,"EP\\7",%PKEY_AudioEndpoint_Association%,,%KSNODETYPE_DESKTOP_MICROPHONE%
HKR,"EP\\7",%PKEY_AudioEndpoint_Supports_EventDriven_Mode%,0x00010001,0x1

HKR,"EP\\8",%PKEY_AudioEndpoint_Association%,,%KSNODETYPE_HEADSET%
HKR,"EP\\8",%PKEY_AudioEndpoint_Supports_EventDriven_Mode%,0x00010001,0x1



;---------------------------------------------------------------
;                D e l R e g
;---------------------------------------------------------------

[HECATE_HD_AUDIO_DEVICE.DelReg]
HKR,Settings

;---------------------------------------------------------------
;                S e r v i c e s  
;---------------------------------------------------------------

[HECATE_HD_AUDIO_DEVICE.NTamd64.Services]
AddService=HECATE_HD_AUDIO_DEVICE, 0x00000002, HECATE_HD_AUDIO_DEVICE.ServiceInstall

[HECATE_HD_AUDIO_DEVICE.ServiceInstall]
DisplayName=%HECATE_HD_AUDIO_DEVICE.SvcDesc%
ServiceType=%SERVICE_KERNEL_DRIVER%
StartType=%SERVICE_DEMAND_START%
ErrorControl=%SERVICE_ERROR_NORMAL%
ServiceBinary=%12%\HECATE_HD_AUDIO_DEVICE.sys

;---------------------------------------------------------------
;                Copy Files
;---------------------------------------------------------------

[HECATE_HD_AUDIO_DEVICE.CopyFiles]
HECATE_HD_AUDIO_DEVICE.SYS

