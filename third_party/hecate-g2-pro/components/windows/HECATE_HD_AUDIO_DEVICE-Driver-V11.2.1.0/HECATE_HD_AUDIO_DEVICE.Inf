;
;EDIFIER Esports Technology Co.,Ltd HECATE Audio Device Driver
;

[Version]
signature="$WINDOWS NT$"
Class=Media
ClassGUID={4d36e96c-e325-11ce-bfc1-08002be10318}
Provider=%CMEDIA%
Catalogfile=HECATE_HD_AUDIO_DEVICE.cat
DriverVer=01/20/2026,11.2.1.0
PnpLockdown=1

[SourceDisksNames]
1000=%cdname%,,,

[SourceDisksFiles.amd64]
HECATE_HD_AUDIO_DEVICE.sys=1000,\x64

[SignatureAttributes]
HECATE_HD_AUDIO_DEVICE.sys=SignatureAttributes.DRM

[SignatureAttributes.DRM]
DRMLevel=1300

[DestinationDirs]
DefaultDestDir=12
HECATE_HD_AUDIO_DEVICE.CopyFiles=12

[Manufacturer]
%ManufacturerString%=ManufacturerID,NTamd64.10.0

[ManufacturerID.NTamd64.10.0]
%HECATE_HD_AUDIO_DEVICE.DeviceDesc%=HECATE_HD_AUDIO_DEVICE,USB\VID_35BB&PID_A100&MI_00
%HECATE_HD_AUDIO_DEVICE.DeviceDesc%=HECATE_HD_AUDIO_DEVICE,USB\VID_35BB&PID_A101&MI_00
%HECATE_HD_AUDIO_DEVICE.DeviceDesc%=HECATE_HD_AUDIO_DEVICE,USB\VID_35BB&PID_A102&MI_00
%HECATE_HD_AUDIO_DEVICE.DeviceDesc%=HECATE_HD_AUDIO_DEVICE,USB\VID_35BB&PID_A103&MI_00
%HECATE_HD_AUDIO_DEVICE.DeviceDesc%=HECATE_HD_AUDIO_DEVICE,USB\VID_35BB&PID_A104&MI_00
%HECATE_HD_AUDIO_DEVICE.DeviceDesc%=HECATE_HD_AUDIO_DEVICE,USB\VID_35BB&PID_A105&MI_00
%HECATE_HD_AUDIO_DEVICE.DeviceDesc%=HECATE_HD_AUDIO_DEVICE,USB\VID_35BB&PID_A106&MI_00
%HECATE_HD_AUDIO_DEVICE.DeviceDesc%=HECATE_HD_AUDIO_DEVICE,USB\VID_35BB&PID_A107&MI_00
%HECATE_HD_AUDIO_DEVICE.DeviceDesc%=HECATE_HD_AUDIO_DEVICE,USB\VID_35BB&PID_A164&MI_00
%HECATE_HD_AUDIO_DEVICE.DeviceDesc%=HECATE_HD_AUDIO_DEVICE,USB\VID_35BB&PID_A165&MI_00


;---------------------------------------------------------------
;                x 64  D D I n s t a l l
;---------------------------------------------------------------

[HECATE_HD_AUDIO_DEVICE.NTamd64]
Include=ks.inf, wdmaudio.inf
Needs=KS.Registration, WDMAUDIO.Registration
DelReg=HECATE_HD_AUDIO_DEVICE.DelReg
AddReg=HECATE_HD_AUDIO_DEVICE.AddReg, HECATE_HD_AUDIO_DEVICE_NAMES.AddReg
AddProperty=HECATE_HD_AUDIO_DEVICEBranding.AddProperty
CopyFiles=HECATE_HD_AUDIO_DEVICE.CopyFiles

[HECATE_HD_AUDIO_DEVICEBranding.AddProperty]
DeviceVendorWebSite,,,,"https://www.edifier.com/" ; Place your URL here

;---------------------------------------------------------------
;                I n t e r f a c e s
;---------------------------------------------------------------

[HECATE_HD_AUDIO_DEVICE.NTamd64.Interfaces]
AddInterface=%KSCATEGORY_AUDIO%,%KSNAME_SPEAKER.WAVE%,Audio.I.SPEAKER.WAVE
AddInterface=%KSCATEGORY_RENDER%,%KSNAME_SPEAKER.WAVE%,Audio.I.SPEAKER.WAVE

AddInterface=%KSCATEGORY_AUDIO%,%KSNAME_COMMSPEAKER.WAVE%,Audio.I.COMMSPEAKER.WAVE
AddInterface=%KSCATEGORY_RENDER%,%KSNAME_COMMSPEAKER.WAVE%,Audio.I.COMMSPEAKER.WAVE

AddInterface=%KSCATEGORY_AUDIO%,%KSNAME_SPDIFOUT.WAVE%,Audio.I.SPDIFOUT.WAVE
AddInterface=%KSCATEGORY_RENDER%,%KSNAME_SPDIFOUT.WAVE%,Audio.I.SPDIFOUT.WAVE

AddInterface=%KSCATEGORY_AUDIO%,%KSNAME_HPOUT.WAVE%,Audio.I.HPOUT.WAVE
AddInterface=%KSCATEGORY_RENDER%,%KSNAME_HPOUT.WAVE%,Audio.I.HPOUT.WAVE

AddInterface=%KSCATEGORY_AUDIO%,%KSNAME_RECIN.WAVE%,Audio.I.RECIN.WAVE
AddInterface=%KSCATEGORY_CAPTURE%,%KSNAME_RECIN.WAVE%,Audio.I.RECIN.WAVE

AddInterface=%KSCATEGORY_AUDIO%,%KSNAME_MICIN.WAVE%,Audio.I.MICIN.WAVE
AddInterface=%KSCATEGORY_CAPTURE%,%KSNAME_MICIN.WAVE%,Audio.I.MICIN.WAVE

AddInterface=%KSCATEGORY_AUDIO%,%KSNAME_LINEIN.WAVE%,Audio.I.LINEIN.WAVE
AddInterface=%KSCATEGORY_CAPTURE%,%KSNAME_LINEIN.WAVE%,Audio.I.LINEIN.WAVE

AddInterface=%KSCATEGORY_AUDIO%,%KSNAME_SPDIFIN.WAVE%,Audio.I.SPDIFIN.WAVE
AddInterface=%KSCATEGORY_CAPTURE%,%KSNAME_SPDIFIN.WAVE%,Audio.I.SPDIFIN.WAVE

AddInterface=%KSCATEGORY_AUDIO%,%KSNAME_HEADSETOUT.WAVE%,Audio.I.HEADSETOUT.WAVE
AddInterface=%KSCATEGORY_CAPTURE%,%KSNAME_HEADSETOUT.WAVE%,Audio.I.HEADSETOUT.WAVE

AddInterface=%KSCATEGORY_AUDIO%,%KSNAME_GLOBAL.TOPO%,Audio.I.GLOBAL.TOPO
AddInterface=%KSCATEGORY_TOPOLOGY%,%KSNAME_GLOBAL.TOPO%,Audio.I.GLOBAL.TOPO

[Audio.I.SPEAKER.WAVE]
AddReg=HECATE_HD_AUDIO_DEVICE.I.SPEAKER.WAVE.AddReg

[Audio.I.COMMSPEAKER.WAVE]
AddReg=HECATE_HD_AUDIO_DEVICE.I.COMMSPEAKER.WAVE.AddReg

[Audio.I.SPDIFOUT.WAVE]
AddReg=HECATE_HD_AUDIO_DEVICE.I.SPDIFOUT.WAVE.AddReg

[Audio.I.HPOUT.WAVE]
AddReg=HECATE_HD_AUDIO_DEVICE.I.HPOUT.WAVE.AddReg

[Audio.I.RECIN.WAVE]
AddReg=HECATE_HD_AUDIO_DEVICE.I.RECIN.WAVE.AddReg

[Audio.I.MICIN.WAVE]
AddReg=HECATE_HD_AUDIO_DEVICE.I.MICIN.WAVE.AddReg

[Audio.I.LINEIN.WAVE]
AddReg=HECATE_HD_AUDIO_DEVICE.I.LINEIN.WAVE.AddReg

[Audio.I.SPDIFIN.WAVE]
AddReg=HECATE_HD_AUDIO_DEVICE.I.SPDIFIN.WAVE.AddReg

[Audio.I.HEADSETOUT.WAVE]
AddReg=HECATE_HD_AUDIO_DEVICE.I.HEADSETOUT.WAVE.AddReg

[Audio.I.GLOBAL.TOPO]
AddReg=HECATE_HD_AUDIO_DEVICE.I.GLOBAL.TOPO.AddReg, HECATE_HD_AUDIO_DEVICE.EPProperties.AddReg

;---------------------------------------------------------------
;                A d d R e g
;---------------------------------------------------------------
[HECATE_HD_AUDIO_DEVICE.AddReg]
HKR,,Driver,,HECATE_HD_AUDIO_DEVICE.sys
HKR,,AssociatedFilters,,"wdmaud,redbook"
HKR,Drivers,SubClasses,,"wave,midi,mixer"
HKR,Drivers\wave\wdmaud.drv, Driver,,wdmaud.drv
HKR,Drivers\midi\wdmaud.drv, Driver,,wdmaud.drv
HKR,Drivers\mixer\wdmaud.drv,Driver,,wdmaud.drv
HKR,Drivers\wave\wdmaud.drv,Description,,%HECATE_HD_AUDIO_DEVICE.Audio.DeviceDesc%
HKR,Drivers\midi\wdmaud.drv,Description,,%HECATE_HD_AUDIO_DEVICE.Audio.DeviceDesc%
HKR,Drivers\mixer\wdmaud.drv,Description,,%HECATE_HD_AUDIO_DEVICE.Audio.DeviceDesc%

[HECATE_HD_AUDIO_DEVICE_NAMES.AddReg]
HKLM,%MediaCategories%\%HECATE_HD_AUDIO_DEVICEGUID.SpdifOut%,Name,,%HECATE_HD_AUDIO_DEVICENode.SpdifOut%
HKLM,%MediaCategories%\%HECATE_HD_AUDIO_DEVICEGUID.SpdifOut%,Display,1,00,00,00,00
HKLM,%MediaCategories%\%HECATE_HD_AUDIO_DEVICEGUID.SpdifIn%,Name,,%HECATE_HD_AUDIO_DEVICENode.SpdifIn%
HKLM,%MediaCategories%\%HECATE_HD_AUDIO_DEVICEGUID.SpdifIn%,Display,1,00,00,00,00

HKLM,%MediaCategories%\%HDAGuidStereoMixPin%,Name,,%HDAStereoMixPinName%
HKLM,%MediaCategories%\%HDAGuidStereoMixPin%,Display,1,00,00,00,00
HKLM,%MediaCategories%\%HDAGuidAuxInPin%,Name,,%HDAAuxInPinName%
HKLM,%MediaCategories%\%HDAGuidAuxInPin%,Display,1,00,00,00,00

[HECATE_HD_AUDIO_DEVICE.I.SPEAKER.WAVE.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%HECATE_HD_AUDIO_DEVICE.SPEAKER.WAVE.szPname%

[HECATE_HD_AUDIO_DEVICE.I.COMMSPEAKER.WAVE.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%HECATE_HD_AUDIO_DEVICE.COMMSPEAKER.WAVE.szPname%

[HECATE_HD_AUDIO_DEVICE.I.SPDIFOUT.WAVE.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%HECATE_HD_AUDIO_DEVICE.SPDIFOUT.WAVE.szPname%

[HECATE_HD_AUDIO_DEVICE.I.HPOUT.WAVE.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%HECATE_HD_AUDIO_DEVICE.HPOUT.WAVE.szPname%

[HECATE_HD_AUDIO_DEVICE.I.RECIN.WAVE.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%HECATE_HD_AUDIO_DEVICE.RECIN.WAVE.szPname%

[HECATE_HD_AUDIO_DEVICE.I.MICIN.WAVE.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%HECATE_HD_AUDIO_DEVICE.MICIN.WAVE.szPname%

[HECATE_HD_AUDIO_DEVICE.I.LINEIN.WAVE.AddReg]
